rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helpers
    function isSignedIn() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    
    // Role based helpers
    function isSuperAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'zeeshanmaqbool200@gmail.com' || 
        getUserData().role == 'superadmin' ||
        getUserData().role == 'admin'
      ); 
    }
    function isManager() { return isSuperAdmin() || (isSignedIn() && (getUserData().role == 'manager' || getUserData().role == 'muntazim')); }
    function isTeacher() { return isManager() || (isSignedIn() && getUserData().role == 'teacher'); }
    function isStaff() { return isTeacher(); }

    // Collection specific rules
    match /forms/{formId} {
      allow get: if true; // Public access for viewing
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && (resource.data.createdBy == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /form_responses/{responseId} {
      allow create: if true; // Public submission if enabled in app logic
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if true; // Public for verification
      allow list: if isStaff();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    match /attendance/{atId} {
      allow read: if isSignedIn() && (isStaff() || resource.data.studentId == request.auth.uid);
      allow write: if isTeacher();
      allow delete: if isManager();
    }

    match /receipts/{rId} {
      allow get: if true; // Public for verification
      allow list: if isStaff() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    match /notifications/{nId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /courses/{cId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /expenses/{eId} {
      allow read: if isManager();
      allow write: if isManager();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Fallback block
    match /{document=**} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow write: if isSignedIn() && isSuperAdmin();
    }
  }
}
