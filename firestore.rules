rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helpers
    function isSignedIn() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    
    // Role based helpers
    function isSuperAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'zeeshanmaqbool200@gmail.com' || 
        getUserData().role == 'superadmin' ||
        getUserData().role == 'super_admin'
      ); 
    }
    function isAdmin() { return isSuperAdmin() || (isSignedIn() && getUserData().role == 'admin'); }
    function isManager() { return isAdmin() || (isSignedIn() && (getUserData().role == 'manager' || getUserData().role == 'muntazim')); }
    function isTeacher() { return isManager() || (isSignedIn() && getUserData().role == 'teacher'); }

    // Ownership helpers
    function isOwner(data) { return isSignedIn() && data.ownerId == request.auth.uid; }
    function isCreator(data) { return isSignedIn() && data.createdBy == request.auth.uid; }

    // Collection specific rules
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update: if isSuperAdmin() || (isTeacher() && isOwner(resource.data));
      allow delete: if isSuperAdmin();
    }

    match /forms/{formId} {
      allow get: if true; 
      allow list: if isTeacher();
      allow create: if isTeacher();
      allow update: if isSuperAdmin() || (isTeacher() && isCreator(resource.data));
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if true; 
      allow list: if isTeacher();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified']));
      allow delete: if isSuperAdmin();
    }

    match /attendance/{atId} {
      allow read: if isSignedIn() && (isTeacher() || resource.data.studentId == request.auth.uid);
      allow write: if isTeacher();
      allow delete: if isManager();
    }

    match /receipts/{rId} {
      allow get: if true;
      allow list: if isTeacher() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{docId} {
      allow read: if isTeacher();
      allow write: if false; // System only or handled via batches
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
